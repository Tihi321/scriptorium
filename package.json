{
  "name": "scriptorium",
  "version": "0.0.1",
  "private": true,
  "description": "Scriptorium: a book factory run by AI agents",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "build:engine": "vite build --config vite.engine.config.ts --logLevel warn",
    "dev": "yarn build:engine && electron-vite dev",
    "build": "yarn build:engine && electron-vite build",
    "engine": "yarn build:engine && node out/engine/index.js",
    "key:set": "yarn build:engine && node out/engine/index.js key-set",
    "dev:ui": "vite --config vite.ui.config.ts --open /?demo",
    "test": "vitest run",
    "test:ui": "playwright test --config playwright.config.ts",
    "test:electron": "yarn build && playwright test --config playwright.electron.config.ts",
    "test:packaged": "yarn dist:dir && playwright test --config playwright.packaged.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "dist": "yarn build && electron-builder --config electron-builder.yml --win nsis --x64",
    "dist:dir": "yarn build && electron-builder --config electron-builder.yml --win dir --x64"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "chokidar": "^4.0.3",
    "jszip": "^3.10.2",
    "nodemailer": "^10.0.16",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "phaser": "^3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "author": "Tihomir Selak"
}
